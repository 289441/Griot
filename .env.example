# Run "npm run keys" to create a real .env.local file. Never commit that file.
DATABASE_URL=postgres://freedom:freedom@localhost:5433/freedom
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:change-me@example.com
CRON_SECRET=

# The public half goes in the app, so it can check every alert.
NEXT_PUBLIC_ALERT_PUBKEY=

# Only the admin side may hold this. Never add it to the public app's hosting.
ALERT_SIGNING_KEY=
